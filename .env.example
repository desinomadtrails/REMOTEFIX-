# RemoteFix Environment Variables Example

# Server Configuration
PORT=8787
NODE_ENV=development

# Database Connection (MSSQL / SQL Server)
DATABASE_URL=sqlserver://localhost:1433;database=remotefix;user=sa;password=YourPassword123;encrypt=true;trustServerCertificate=true

# JWT Authentication Secret (Minimum 32 characters)
JWT_SECRET=super-secret-key-min-32-chars-remotefix

# TokenRouter LLM Provider Configuration
TOKENROUTER_API_KEY=your_tokenrouter_api_key_here
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=moonshotai/kimi-k3-free
