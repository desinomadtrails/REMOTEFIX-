{
  "name": "@remotefix/database",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/database/index.js",
  "types": "./dist/database/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx database/migrations/run-migration.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx database/seed/run-seed.ts",
    "db:test": "tsx database/connection-test.ts"
  },
  "dependencies": {
    "@remotefix/types": "*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^1.0.0-rc.4",
    "mssql": "^11.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "drizzle-kit": "^1.0.0-rc.4",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
